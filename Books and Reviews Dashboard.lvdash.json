{
  "datasets": [
    {
      "name": "book_rating_dist",
      "displayName": "Book Rating Distribution",
      "config": {
        "version": "1.1",
        "source": "SELECT `ISBN`, COUNT(*) AS rating_count, AVG(`Book-Rating`) AS avg_rating FROM workspace.default.ratings GROUP BY `ISBN` HAVING AVG(`Book-Rating`) > 0\n",
        "dimensions": [
          {
            "displayName": "Number of Ratings per Book",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            },
            "name": "rating_count",
            "expr": "rating_count",
            "comment": "How many ratings each book received"
          },
          {
            "name": "rating_range",
            "expr": "CASE\n  WHEN rating_count = 1 THEN '1'\n  WHEN rating_count BETWEEN 2 AND 5 THEN '2-5'\n  WHEN rating_count BETWEEN 6 AND 10 THEN '6-10'\n  WHEN rating_count BETWEEN 11 AND 25 THEN '11-25'\n  WHEN rating_count BETWEEN 26 AND 50 THEN '26-50'\n  WHEN rating_count BETWEEN 51 AND 100 THEN '51-100'\n  WHEN rating_count > 100 THEN '100+'\nEND",
            "displayName": "Rating Count Range",
            "comment": "Binned ranges of rating counts"
          },
          {
            "displayName": "Average Rating",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            },
            "name": "avg_rating",
            "expr": "avg_rating",
            "comment": "Average rating value (0-10 scale)"
          }
        ],
        "measures": [
          {
            "displayName": "Number of Books",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            },
            "name": "num_books",
            "expr": "COUNT(*)",
            "comment": "Count of books that have this number of ratings"
          }
        ]
      }
    },
    {
      "name": "top_books_weighted",
      "displayName": "Top Books by Weighted Rating",
      "config": {
        "version": "1.1",
        "source": "WITH book_ratings AS (\n  SELECT \n    r.`ISBN`,\n    b.`Book-Title`,\n    COUNT(*) AS rating_count,\n    AVG(r.`Book-Rating`) AS avg_rating\n  FROM workspace.default.ratings r\n  JOIN workspace.default.books b ON r.`ISBN` = b.`ISBN`\n  GROUP BY r.`ISBN`, b.`Book-Title`\n  HAVING COUNT(*) >= 10\n) SELECT \n  `ISBN`,\n  `Book-Title`,\n  rating_count,\n  avg_rating,\n  (rating_count / (rating_count + 50.0)) * avg_rating + (50.0 / (rating_count + 50.0)) * 5.0 AS weighted_rating\nFROM book_ratings ORDER BY weighted_rating DESC LIMIT 10\n",
        "dimensions": [
          {
            "name": "Book-Title",
            "expr": "`Book-Title`",
            "displayName": "Book Title"
          },
          {
            "name": "ISBN",
            "expr": "ISBN",
            "displayName": "ISBN"
          },
          {
            "name": "rating_count",
            "expr": "rating_count",
            "displayName": "Number of Ratings",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "avg_rating",
            "expr": "avg_rating",
            "displayName": "Average Rating",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "weighted_rating",
            "expr": "weighted_rating",
            "displayName": "Weighted Rating",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          }
        ],
        "measures": []
      }
    },
    {
      "name": "top_30_weighted_books",
      "displayName": "Top 20 Books by Weighted Rating",
      "queryLines": [
        "SELECT\n",
        "  b.`Book-Title`,\n",
        "  b.`Book-Author`,\n",
        "  q.ISBN,\n",
        "  q.rating_count,\n",
        "  ROUND(q.avg_rating, 2) AS avg_rating,\n",
        "  ROUND(q.weighted_rating, 2) AS weighted_rating\n",
        "FROM\n",
        "  workspace.default.book_quality_scores q\n",
        "    INNER JOIN workspace.default.books b\n",
        "      ON q.ISBN = b.ISBN\n",
        "ORDER BY\n",
        "  q.weighted_rating DESC\n",
        "LIMIT 20"
      ],
      "columns": [
        {
          "displayName": "Book Label",
          "description": "Combined label showing book title and ISBN",
          "expression": "CONCAT(`Book-Title`, ' — ', `ISBN`)"
        }
      ]
    },
    {
      "name": "author_quality_scores",
      "displayName": "Author Quality Scores",
      "queryLines": [
        "SELECT\n",
        "  author,\n",
        "  ROUND(author_quality_score, 2) AS author_quality_score\n",
        "FROM\n",
        "  workspace.default.author_final_scores\n",
        "WHERE\n",
        "  LOWER(TRIM(author)) NOT LIKE '%not applicable%'\n",
        "ORDER BY\n",
        "  author_quality_score DESC\n",
        "LIMIT 20"
      ]
    },
    {
      "name": "geographic_reach",
      "displayName": "Geographic Reach Distribution",
      "queryLines": [
        "WITH book_reach AS (\n",
        "  SELECT\n",
        "    s.ISBN,\n",
        "    COUNT(DISTINCT s.continent) AS continents_reached\n",
        "  FROM\n",
        "    workspace.default.book_continent_stats s\n",
        "      INNER JOIN workspace.default.eligible_books e\n",
        "        ON s.ISBN = e.ISBN\n",
        "  GROUP BY\n",
        "    s.ISBN\n",
        ")\n",
        "SELECT\n",
        "  continents_reached,\n",
        "  COUNT(*) AS number_of_books,\n",
        "  ROUND(100.0 * COUNT(*) / SUM(COUNT(*)) OVER (), 2) AS percentage_of_books\n",
        "FROM\n",
        "  book_reach\n",
        "GROUP BY\n",
        "  continents_reached\n",
        "ORDER BY\n",
        "  continents_reached"
      ]
    },
    {
      "name": "language_reach",
      "displayName": "Top Books by Language Reach",
      "queryLines": [
        "SELECT\n",
        "  title,\n",
        "  number_of_languages\n",
        "FROM\n",
        "  workspace.default.international_book_works\n",
        "WHERE\n",
        "  number_of_languages IS NOT NULL\n",
        "ORDER BY\n",
        "  number_of_languages DESC\n",
        "LIMIT 20"
      ]
    },
    {
      "name": "final_recommendations",
      "displayName": "Top Books for International Expansion",
      "queryLines": [
        "SELECT\n",
        "  title,\n",
        "  ROUND(international_relevance_score, 2) AS international_relevance_score\n",
        "FROM\n",
        "  workspace.default.final_book_recommendations\n",
        "ORDER BY\n",
        "  international_relevance_score DESC\n",
        "LIMIT 20"
      ]
    }
  ],
